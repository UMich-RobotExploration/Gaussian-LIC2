          Size (m): 0.009999999776482582
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /spline/ctrl_cloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
      Enabled: true
      Name: B-spline
    - Alpha: 0.10000000149011612
